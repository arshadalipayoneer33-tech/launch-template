# ==============================================================================
# CLOUDFLARE PAGES SECURITY HEADERS (_headers)
# Applied to all incoming requests across the edge network
# ==============================================================================

/*
  # HTTP Strict Transport Security (HSTS)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Stop clickjacking attacks by preventing iframe embedding
  X-Frame-Options: DENY

  # Enable browser XSS filtering
  X-XSS-Protection: 1; mode=block

  # Control referrer leakage
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable access to unused sensitive hardware APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy (Allows self and inline scripts/styles for dynamic theming)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# Cache-Control optimizations for static assets
/public/css/*
  Cache-Control: public, max-age=31536000, immutable

/public/js/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
