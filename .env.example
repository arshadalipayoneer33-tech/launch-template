# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env for local development.
# NEVER commit real .env files with live credentials to Git.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Site URL (Used for canonical metadata & CORS origin validation)
SITE_URL=http://localhost:3000

# Demo Authentication Token (Strictly for local/mock demonstration)
# Leave unchanged for testing, or set a custom token for your demo.
DEMO_AUTH_TOKEN=launchflow-demo-session-token-v1

# Optional: Supabase Database & Auth Integration (Free Tier)
# For production auth and persistent database, obtain free credentials at https://supabase.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key

# Optional: Email Delivery Service (Required for actual contact form inbox forwarding)
# When unset, contact form submissions are logged to server console only (Demo Mode).
RESEND_API_KEY=re_your_free_resend_api_key
CONTACT_RECIPIENT_EMAIL=your-verified-recipient@domain.com

# Optional: Notification Webhook (Discord, Slack, or Telegram for contact form alerts)
CONTACT_NOTIFICATION_WEBHOOK=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
